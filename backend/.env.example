DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
ENVIRONMENT=development
JWT_SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEFAULT_CURRENCY=KES
DATABASE_URL_TEST=postgresql+psycopg://USER:PASSWORD@HOST:PORT/shambatrack_test
REDIS_URL=redis://localhost:6379/0
SMS_SIMULATED_FAILURE_RATE=0.1

# Observability. LOG_JSON=false gives readable lines for local work.
LOG_LEVEL=INFO
LOG_JSON=true
SLOW_REQUEST_MS=500

# Database pool and server-side statement timeout.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_STATEMENT_TIMEOUT_MS=5000

# Login throttling: failures per window (per account), window, first lockout.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900